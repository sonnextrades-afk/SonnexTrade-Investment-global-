<!DOCTYPE html>
<html>
<head>
<title>User Dashboard - SonnexTrade Global</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<header><h1>SonnexTrade Global</h1><button onclick="logout()">Logout</button></header>
<div class="container">
  <div class="card">
    <h3>Welcome, <span id="userEmail"></span></h3>
    <h2>Wallet Balance: $<span id="balance">0.00</span></h2>
    <p>Status: <span id="kycStatus">Pending</span></p>
  </div>
  <div class="card">
    <h3>Deposit / Withdraw</h3>
    <input type="number" id="amount" placeholder="Amount">
    <button onclick="requestDeposit()">Request Deposit</button>
    <button onclick="requestWithdraw()">Request Withdraw</button>
  </div>
  <div class="card">
    <h3>My Transactions</h3>
    <ul id="transactions"></ul>
  </div>
</div>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
<script src="app.js"></script>
<script>checkUserPage();</script>
</body>
</html>
